{
    "name": "vortech/softdeletes-flag",
    "description": "Drop-in soft deletes for Laravel Eloquent that use an indexed boolean flag instead of a nullable timestamp, for faster queries in high-load applications.",
    "keywords": [
        "vortech",
        "softdeletes-flag",
        "laravel",
        "eloquent",
        "soft-delete",
        "soft-deletes",
        "boolean",
        "flag",
        "index",
        "performance",
        "database",
        "mysql",
        "unique-index"
    ],
    "homepage": "https://github.com/Vortech-Group/softdeletes-flag",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mate Papp",
            "email": "mate@vortech.hu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Vortech\\SoftDeletesFlag\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vortech\\SoftDeletesFlag\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vortech\\SoftDeletesFlag\\Providers\\SoftDeletesFlagServiceProvider"
            ]
        }
    }
}
